# /etc/agentjudge/env （chmod 600, chown root:agentjudge）
# 工作台/API 的 Bearer Token，必须设置为随机强口令
AGENTJUDGE_TOKEN=change-me-to-a-long-random-token

# 审计链 HMAC 密钥（32 字节，hex 或 base64）。
# 不设置时首次启动会在 var/hmac.key 自动生成；生产环境建议由 KMS 注入。
# AGENTJUDGE_HMAC_KEY=

# 可选的语义研判模型（离线部署可留空，回退为确定性启发式研判）
# AGENTJUDGE_LLM_KEY=
# AGENTJUDGE_POLICY=/opt/agentjudge/policies/default.toml

# 告警通道（在策略 [alerting] 中启用后生效）
# AGENTJUDGE_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# AGENTJUDGE_SMTP_PASSWORD=change-me
